<%- include('partials/header', { title: '登录' }) %>
<section class="auth">
  <h1>登录</h1>
  <form action="/login" method="post">
    <label>用户名或邮箱<input type="text" name="login" required autofocus></label>
    <label>密码<input type="password" name="password" required></label>
    <button class="btn" type="submit">登录</button>
  </form>
  <p class="muted">还没有账号？<a href="/register">去注册</a></p>
</section>
<%- include('partials/footer') %>
