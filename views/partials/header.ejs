<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>云闲摄影</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">云闲<span>摄影</span></a>
    <nav class="nav">
      <a href="/">作品</a>
      <% if (currentUser && currentUser.is_admin) { %><a href="/admin">管理后台</a><% } %>
      <% if (currentUser) { %>
        <span class="hello">你好，<%= currentUser.username %></span>
        <form class="inline-form" action="/logout" method="post"><button class="link-btn" type="submit">退出</button></form>
      <% } else { %>
        <a href="/login">登录</a>
        <a href="/register" class="btn-small">注册</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
