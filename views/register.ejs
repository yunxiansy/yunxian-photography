<%- include('partials/header', { title: '注册' }) %>
<section class="auth">
  <h1>注册账号</h1>
  <p class="muted">注册后可以在作品下留言。</p>
  <form action="/register" method="post">
    <label>用户名<input type="text" name="username" minlength="2" maxlength="20" required autofocus></label>
    <label>邮箱<input type="email" name="email" required></label>
    <label>密码（至少 6 位）<input type="password" name="password" minlength="6" required></label>
    <button class="btn" type="submit">注册并登录</button>
  </form>
  <p class="muted">已有账号？<a href="/login">去登录</a></p>
</section>
<%- include('partials/footer') %>
