<%- include('partials/header') %>

<section class="hero">
  <h1>云闲摄影</h1>
  <p>闲云野鹤般地走，认真地看，慢慢地拍。</p>
</section>

<div class="filters">
  <a href="/" class="<%= !activeCategory ? 'active' : '' %>">全部</a>
  <% categories.forEach(function (c) { %>
    <a href="/?category=<%= encodeURIComponent(c) %>" class="<%= activeCategory === c ? 'active' : '' %>"><%= c %></a>
  <% }) %>
</div>

<% if (photos.length === 0) { %>
  <p class="empty">这个分类下还没有作品。</p>
<% } else { %>
  <div class="grid">
    <% photos.forEach(function (p) { %>
      <a class="card" href="/photo/<%= p.id %>">
        <div class="thumb"><img src="<%= p.path.startsWith('/seed/') ? '/static' + p.path : p.path %>" alt="<%= p.title %>" loading="lazy"></div>
        <div class="card-body">
          <h2><%= p.title %></h2>
          <p class="meta"><%= p.category %> · <%= p.created_at.slice(0, 10) %><% if (p.is_sample) { %> · 示例<% } %></p>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
